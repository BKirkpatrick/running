---
import LogReader from '../components/LogReader.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="What I code about when I code about running">
	<div class="sheet">
		<header class="masthead">
			<h1>What I code about when I code about running</h1>
		</header>

		<main>
			<LogReader />
		</main>

		<footer class="colophon">
			<p>&mdash; end of transmission &mdash;</p>
			<p class="prompt"><span>$</span> <span class="cursor" aria-hidden="true"></span></p>
		</footer>
	</div>
</Layout>

<style>
	.sheet {
		max-width: 50rem;
		margin: 0 auto;
		padding: clamp(1.5rem, 5vw, 4rem) clamp(1.25rem, 5vw, 3rem) 4rem;
	}

	/* Masthead: centred title between a double and a single rule. */
	.masthead {
		border-top: 4px double var(--rule);
		border-bottom: 1px solid var(--rule);
		padding: 1rem 0;
		text-align: center;
	}

	h1 {
		margin: 0 auto;
		max-width: 22ch;
		font-family: var(--display);
		font-size: clamp(1.75rem, 4.5vw, 2.75rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	main {
		margin-top: 2.5rem;
	}

	.colophon {
		margin-top: 3.5rem;
		text-align: center;
		font-size: 0.8125rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--ink-2);
	}

	.colophon p {
		margin: 0;
	}

	.prompt {
		margin-top: 0.75rem !important;
		letter-spacing: 0;
		color: var(--ink);
	}

	.cursor {
		display: inline-block;
		width: 0.6em;
		height: 1.1em;
		vertical-align: text-bottom;
		background: var(--ink);
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}
</style>
